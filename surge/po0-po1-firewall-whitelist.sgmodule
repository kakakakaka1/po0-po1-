#!name=po0 + po1 防火墙自动加白
#!desc=调用 po0 / po1 两套防火墙 API 把本机当前出口 IP 加入白名单。po0 支持多 token（英文逗号分割，对应多台机器）；po1 为腾讯云 ECS 白名单分享链接（ctecsfw_ 开头），同样支持多 token 与 @槽位。network-changed 事件与每 10 分钟 cron 自动触发，附带手动刷新面板。
#!category=防火墙
#!author=reallinzc（po0）/ po1 扩展
#!homepage=https://po0fw.uuuz.de/
#!arguments=tokens:"",tokens1:""
#!arguments-desc=tokens: po0 防火墙 API token（pgnfw_ 开头），多台机器用英文逗号分割；可选 token@槽位（如 pgnfw_xxx@0）钉固定坑位、永不被淘汰 / tokens1: po1 白名单 token（ctecsfw_ 开头），多台机器用英文逗号分割；可选 token@槽位（如 ctecsfw_xxx@4）钉固定槽位

[Rule]
# 加白 API 必须直连，确保服务端看到的是本机真实出口 IP，而不是代理出口
# po0：API 是裸 IP，直接用 IP-CIDR 锁定
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve
# po1：www.guguyun.com 是多 IP 的 CDN（实测 103.120.90.53 / 103.120.90.209 / 69.165.68.160），
# 写 IP-CIDR 会在解析到新节点后失效，所以用域名规则
DOMAIN-SUFFIX,guguyun.com,DIRECT

[Script]
po0-fw-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/w0ven/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/w0ven/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/w0ven/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po1-fw-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/kakakakaka1/po0-po1-/main/scripts/po1-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens1}}}"
po1-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/kakakakaka1/po0-po1-/main/scripts/po1-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens1}}}"
po1-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/kakakakaka1/po0-po1-/main/scripts/po1-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens1}}}"

[Panel]
po0-fw = script-name=po0-fw-panel,title=po0 防火墙加白,content=点击刷新,update-interval=300
po1-fw = script-name=po1-fw-panel,title=po1 防火墙加白,content=点击刷新,update-interval=300
